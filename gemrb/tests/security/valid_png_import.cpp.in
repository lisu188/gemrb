#include "Video/ImageBufferSize.h"
#include <png.h>
#include <cstring>
#include <fstream>
#include <iostream>
#include <memory>
#include <sstream>
#include <vector>

namespace GemRB {
using strret_t = std::ptrdiff_t;
struct Size {
    int w = 0, h = 0;
    Size() = default;
    Size(int width, int height) : w(width), h(height) {}
};
class DataStream {
    std::vector<unsigned char> bytes;
    size_t pos = 0;
public:
    explicit DataStream(const char* path) {
        std::ifstream input(path, std::ios::binary);
        bytes.assign(std::istreambuf_iterator<char>(input), {});
    }
    strret_t Read(void* output, size_t count) {
        if (count > bytes.size() - pos) return -1;
        std::memcpy(output, bytes.data() + pos, count);
        pos += count;
        return strret_t(count);
    }
};
struct PNGInternal {
    png_structp png_ptr = nullptr;
    png_infop info_ptr = nullptr, end_info = nullptr;
};
class PNGImporter {
public:
    std::unique_ptr<PNGInternal> inf = std::make_unique<PNGInternal>();
    Size size;
    bool hasPalette = false;
    ~PNGImporter() { Close(); }
    void Close();
    bool Import(DataStream*);
};
}
using namespace GemRB;

@READ_CALLBACK@
@CLOSE@
@IMPORT@

int main(int argc, char** argv) {
    if (argc != 3) return 2;
    size_t ordinarySize;
    if (!CheckedImageByteCount(640, 480, 4, ordinarySize) || ordinarySize != 1228800) return 3;
    DataStream input(argv[1]);
    PNGImporter importer;
    if (!importer.Import(&input) || importer.size.w != 3 || importer.size.h != 2) return 4;
    const size_t bytesPerPixel = importer.hasPalette ? 1 : 4;
    const size_t rowBytes = size_t(importer.size.w) * bytesPerPixel;
    std::vector<unsigned char> pixels(rowBytes * importer.size.h);
    std::vector<png_bytep> rows(importer.size.h);
    for (size_t y = 0; y < rows.size(); ++y) rows[y] = pixels.data() + y * rowBytes;
    if (setjmp(png_jmpbuf(importer.inf->png_ptr))) return 5;
    png_read_image(importer.inf->png_ptr, rows.data());
    png_read_end(importer.inf->png_ptr, importer.inf->end_info);
    const char digits[] = "0123456789abcdef";
    std::string actual;
    for (unsigned char value : pixels) { actual += digits[value >> 4]; actual += digits[value & 15]; }
    if (actual != argv[2]) { std::cerr << actual << '\n'; return 6; }
    return 0;
}
